{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://digital-market.local/schemas/v3/reasoning-graph.schema.json",
  "title": "DigitalMarketReasoningGraphV3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "graphId",
    "schemaVersion",
    "reasoningEngineVersion",
    "revision",
    "nodes",
    "edges",
    "indexes"
  ],
  "properties": {
    "graphId": {
      "type": "string",
      "pattern": "^GRF-[0-9a-f]{16}$"
    },
    "schemaVersion": {
      "const": "3.0.0"
    },
    "reasoningEngineVersion": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "stableKey",
          "status",
          "phase",
          "moduleId",
          "payload",
          "createdRevision",
          "lastValidatedRevision",
          "supersedes",
          "supersededBy"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "EVIDENCE",
              "CONTEXT_AXIS_VALUE",
              "DECISION_NODE",
              "CALCULATION",
              "EXTERNAL_KNOWLEDGE_CLAIM",
              "PROPOSAL",
              "DECISION",
              "RISK",
              "CONTRADICTION",
              "OUTPUT_CLAIM",
              "OUTPUT_SECTION",
              "GATE"
            ]
          },
          "stableKey": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "ACTIVE",
              "CONFIRMED",
              "PROVISIONAL",
              "NEEDS_REVIEW",
              "BLOCKED",
              "STALE",
              "SUPERSEDED",
              "DEPRECATED",
              "NOT_APPLICABLE"
            ]
          },
          "phase": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 8
          },
          "moduleId": {
            "type": [
              "string",
              "null"
            ]
          },
          "payload": {
            "type": "object"
          },
          "createdRevision": {
            "type": "integer",
            "minimum": 0
          },
          "lastValidatedRevision": {
            "type": "integer",
            "minimum": 0
          },
          "supersedes": {
            "type": [
              "string",
              "null"
            ]
          },
          "supersededBy": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "edges": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "from",
          "to",
          "qualifier",
          "metadata",
          "createdRevision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^EDG-[0-9a-f]{16}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "REQUIRES",
              "INFLUENCES",
              "DERIVES",
              "ACTIVATES",
              "INVALIDATES",
              "CONTRADICTS",
              "SUPPORTS",
              "BLOCKS",
              "SUPERSEDES"
            ]
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "qualifier": {
            "type": [
              "string",
              "null"
            ]
          },
          "metadata": {
            "type": "object"
          },
          "createdRevision": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "indexes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outgoing",
        "incoming"
      ],
      "properties": {
        "outgoing": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        "incoming": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
