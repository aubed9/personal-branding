{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://digital-market.local/schemas/v3/proposal.schema.json",
  "title": "DigitalMarketProposalClaimV3",
  "allOf": [
    {
      "$ref": "claim.schema.json"
    },
    {
      "type": "object",
      "required": [
        "claimType",
        "proposalStatus"
      ],
      "properties": {
        "claimType": {
          "const": "PROPOSAL"
        },
        "proposalStatus": {
          "type": "string",
          "enum": [
            "CANDIDATE",
            "RECOMMENDED",
            "ACCEPTED",
            "REJECTED",
            "SUPERSEDED",
            "STALE"
          ]
        }
      }
    }
  ]
}
